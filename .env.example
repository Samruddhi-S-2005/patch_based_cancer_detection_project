# ==============================================================================
# PathoVision AI - Environment Configuration Example
# Copy this file to .env and adjust values for your deployment environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Streamlit Web Workstation Settings
# ------------------------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=4096
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# ------------------------------------------------------------------------------
# 2. Hardware & Compute Device Configuration
# Options: 'cuda' (NVIDIA GPU), 'cpu' (fallback), or leave empty for auto-detect
# ------------------------------------------------------------------------------
PATHOVISION_DEVICE=cuda

# ------------------------------------------------------------------------------
# 3. Path & Directory Configurations (Relative to repository root or absolute)
# ------------------------------------------------------------------------------
PATHOVISION_DATA_DIR=data
PATHOVISION_CHECKPOINT_DIR=result/objective_2/checkpoints
PATHOVISION_RESULTS_DIR=results

# ------------------------------------------------------------------------------
# 4. Authentication & Security Configuration
# Default credentials initialized upon first startup if users.json is absent.
# IMPORTANT: Change these values before deploying in production environments.
# ------------------------------------------------------------------------------
INITIAL_RESEARCHER_PW=ResearchPass2026!
INITIAL_REVIEWER_PW=ReviewerAudit2026!
PATHOVISION_REVIEW_SECRET=PATHOVISION_REVIEW_SECRET_2026

# ------------------------------------------------------------------------------
# 5. Logging & Diagnostics
# Options: DEBUG, INFO, WARNING, ERROR
# ------------------------------------------------------------------------------
PATHOVISION_LOG_LEVEL=INFO
